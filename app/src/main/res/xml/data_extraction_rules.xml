<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Whitelist ONLY non-secret alarm/history database; sharedpref secrets are never included -->
    <cloud-backup>
        <include domain="database" path="klock.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="klock.db" />
    </device-transfer>
</data-extraction-rules>
